<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<!--
	Motty's AppleScript dictionary. Its verbs, classes and four-letter codes
	are Terminal.app's, so scripts written for Terminal (and Otty) work with
	the application name changed. Bundled as Contents/Resources/Motty.sdef
	(OSAScriptingDefinition); the cocoa keys are implemented in
	crates/motty-app/src/applescript.
-->
<dictionary title="Motty Terminology">
	<suite name="Standard Suite" code="????" description="Common classes and commands for all applications.">
		<enumeration name="save options" code="savo">
			<enumerator name="yes" code="yes " description="Save the file."/>
			<enumerator name="no" code="no  " description="Do not save the file."/>
			<enumerator name="ask" code="ask " description="Ask the user whether or not to save the file."/>
		</enumeration>
		<command name="close" code="coreclos" description="Close a window.">
			<cocoa class="NSCloseCommand"/>
			<direct-parameter type="specifier" description="The window(s) to close."/>
			<parameter name="saving" code="savo" type="save options" optional="yes" description="Ignored: Motty asks before closing a window with running commands.">
				<cocoa key="SaveOptions"/>
			</parameter>
		</command>
		<command name="count" code="corecnte" description="Return the number of elements of a particular class within an object.">
			<cocoa class="NSCountCommand"/>
			<direct-parameter type="specifier" description="The object whose elements are to be counted."/>
			<parameter name="each" code="kocl" type="type" optional="yes" description="The class of objects to be counted.">
				<cocoa key="ObjectClass"/>
			</parameter>
			<result type="integer" description="The number of elements."/>
		</command>
		<command name="exists" code="coredoex" description="Verify if an object exists.">
			<cocoa class="NSExistsCommand"/>
			<direct-parameter type="specifier" description="The object in question."/>
			<result type="boolean" description="True if it exists, false if not."/>
		</command>
		<command name="quit" code="aevtquit" description="Quit the application.">
			<cocoa class="NSQuitCommand"/>
			<parameter name="saving" code="savo" type="save options" optional="yes" description="Ignored.">
				<cocoa key="SaveOptions"/>
			</parameter>
		</command>

		<class name="application" code="capp" description="The application's top-level scripting object.">
			<cocoa class="NSApplication"/>
			<property name="name" code="pnam" type="text" access="r" description="The name of the application.">
				<cocoa key="mottyName"/>
			</property>
			<property name="frontmost" code="pisf" type="boolean" access="r" description="Is this the frontmost (active) application?">
				<cocoa key="isActive"/>
			</property>
			<property name="version" code="vers" type="text" access="r" description="The version of the application.">
				<cocoa key="mottyVersion"/>
			</property>
			<element type="window" access="r" description="Motty's windows, front to back.">
				<cocoa key="mottyWindows"/>
			</element>
			<responds-to command="quit">
				<cocoa method="handleQuitScriptCommand:"/>
			</responds-to>
		</class>

		<class name="window" code="cwin" description="A Motty window.">
			<cocoa class="NSWindow"/>
			<property name="name" code="pnam" type="text" access="r" description="The title the window shows: its selected tab's.">
				<cocoa key="mottyName"/>
			</property>
			<property name="id" code="ID  " type="integer" access="r" description="The unique identifier of the window.">
				<cocoa key="mottyID"/>
			</property>
			<property name="index" code="pidx" type="integer" description="The index of the window, ordered front to back.">
				<cocoa key="mottyIndex"/>
			</property>
			<property name="bounds" code="pbnd" type="rectangle" description="The bounding rectangle of the window.">
				<cocoa key="boundsAsQDRect"/>
			</property>
			<property name="closeable" code="hclb" type="boolean" access="r" description="Whether the window has a close box.">
				<cocoa key="hasCloseBox"/>
			</property>
			<property name="miniaturizable" code="ismn" type="boolean" access="r" description="Whether the window can be minimized.">
				<cocoa key="isMiniaturizable"/>
			</property>
			<property name="miniaturized" code="pmnd" type="boolean" description="Whether the window is currently minimized.">
				<cocoa key="isMiniaturized"/>
			</property>
			<property name="resizable" code="prsz" type="boolean" access="r" description="Whether the window can be resized.">
				<cocoa key="isResizable"/>
			</property>
			<property name="visible" code="pvis" type="boolean" description="Whether the window is currently visible.">
				<cocoa key="isVisible"/>
			</property>
			<property name="zoomable" code="iszm" type="boolean" access="r" description="Whether the window can be zoomed.">
				<cocoa key="isZoomable"/>
			</property>
			<property name="zoomed" code="pzum" type="boolean" description="Whether the window is currently zoomed.">
				<cocoa key="isZoomed"/>
			</property>
			<property name="frontmost" code="pisf" type="boolean" description="Whether the window is currently the frontmost Motty window.">
				<cocoa key="mottyFrontmost"/>
			</property>
			<element type="tab" access="r" description="The window's tabs that hold a terminal, in the tab list's order.">
				<cocoa key="mottyTabs"/>
			</element>
			<contents name="selected tab" code="tcnt" type="tab" description="The tab the window shows.">
				<cocoa key="mottySelectedTab"/>
			</contents>
			<responds-to command="close">
				<cocoa method="handleCloseScriptCommand:"/>
			</responds-to>
		</class>
	</suite>

	<suite name="Terminal Suite" code="trmx" description="Terminal.app's classes and commands, as Motty has them.">
		<command name="do script" code="coredosc" description="Runs a shell command: in a new window, or typed into a tab (its focused pane) as if followed by Return.">
			<cocoa class="MottyDoScriptCommand"/>
			<direct-parameter type="text" optional="yes" description="The command to execute."/>
			<parameter name="with command" code="cmnd" optional="yes" hidden="yes" description="The command to execute. Deprecated; use the direct parameter instead.">
				<cocoa key="Command"/>
				<type type="text"/>
				<type type="any"/>
			</parameter>
			<parameter name="in" code="kfil" optional="yes" description="The tab (or window: its selected tab) in which to execute the command.">
				<cocoa key="Target"/>
				<type type="tab"/>
				<type type="window"/>
				<type type="any"/>
			</parameter>
			<result type="tab" description="The tab the command was executed in."/>
		</command>

		<class name="tab" plural="tabs" code="ttab" description="A tab. Motty tabs can be split into panes: a tab's properties read its focused pane, and do script types there.">
			<cocoa class="MottyScriptTab"/>
			<property name="id" code="ID  " type="integer" access="r" description="The focused pane's id: what $MOTTY_PANE_ID holds and the motty command line takes. Any of the tab's pane ids finds it (tab id N).">
				<cocoa key="mottyID"/>
			</property>
			<property name="number of rows" code="crow" type="integer" access="r" description="The number of rows displayed in the tab.">
				<cocoa key="mottyRows"/>
			</property>
			<property name="number of columns" code="ccol" type="integer" access="r" description="The number of columns displayed in the tab.">
				<cocoa key="mottyColumns"/>
			</property>
			<property name="contents" code="pcnt" type="text" access="r" description="The currently visible contents of the tab. Empty for SSH and sudo sessions unless ipc-allow-sensitive-sessions is on.">
				<cocoa key="mottyContents"/>
			</property>
			<property name="history" code="hist" type="text" access="r" description="The whole scrollback plus the visible screen. Empty for SSH and sudo sessions unless ipc-allow-sensitive-sessions is on.">
				<cocoa key="mottyHistory"/>
			</property>
			<property name="busy" code="busy" type="boolean" access="r" description="Whether a program other than the shell is running in the tab.">
				<cocoa key="mottyBusy"/>
			</property>
			<property name="processes" code="prcs" access="r" description="The names of the processes running in the tab: the shell and everything under it.">
				<cocoa key="mottyProcesses"/>
				<type type="text" list="yes"/>
			</property>
			<property name="selected" code="tbsl" type="boolean" description="Whether the tab is the one its window shows. Set it to true to bring the tab forward.">
				<cocoa key="mottySelected"/>
			</property>
			<property name="custom title" code="titl" type="text" description="The tab's name, which programs can't change. Set it to &quot;&quot; to give the title back to the shell.">
				<cocoa key="mottyCustomTitle"/>
			</property>
			<property name="tty" code="ttty" type="text" access="r" description="The tab's TTY device.">
				<cocoa key="mottyTTY"/>
			</property>
			<property name="working directory" code="Mcwd" type="text" access="r" description="The shell's current directory.">
				<cocoa key="mottyWorkingDirectory"/>
			</property>
		</class>
	</suite>
</dictionary>
