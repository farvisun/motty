# One Dark: written from the scheme's published palette (MIT). By Atom.

[meta]
name        = "One Dark"
author      = "Atom"
mode        = "dark"
description = "Atom's iconic dark syntax colors."

[terminal]
foreground           = "#ABB2BF"
background           = "#282C34"
cursor               = "#ABB2BF"
cursor-text          = "#282C34"
selection-background = "#3E4451"
palette = [
    "#282C34", "#E06C75", "#98C379", "#E5C07B",
    "#61AFEF", "#C678DD", "#56B6C2", "#ABB2BF",
    "#5C6370", "#E06C75", "#98C379", "#E5C07B",
    "#61AFEF", "#C678DD", "#56B6C2", "#FFFFFF",
]
