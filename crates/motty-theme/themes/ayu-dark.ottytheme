# Ayu Dark: written from the scheme's published palette (MIT). By ayu-theme.

[meta]
name        = "Ayu Dark"
author      = "ayu-theme"
mode        = "dark"
description = "Simple, bright and elegant."

[terminal]
foreground           = "#BFBDB6"
background           = "#0B0E14"
cursor               = "#BFBDB6"
cursor-text          = "#0B0E14"
selection-background = "#273747"
palette = [
    "#1E232B", "#EA6C73", "#7FD962", "#F9AF4F",
    "#53BDFA", "#CDA1FA", "#90E1C6", "#C7C7C7",
    "#686868", "#F07178", "#AAD94C", "#FFB454",
    "#59C2FF", "#D2A6FF", "#95E6CB", "#FFFFFF",
]
