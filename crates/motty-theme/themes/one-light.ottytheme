# One Light: written from the scheme's published palette (MIT). By Atom.

[meta]
name        = "One Light"
author      = "Atom"
mode        = "light"
description = "Atom's light syntax colors."

[terminal]
foreground           = "#383A42"
background           = "#FAFAFA"
cursor               = "#383A42"
cursor-text          = "#FAFAFA"
selection-background = "#E5E5E6"
palette = [
    "#383A42", "#E45649", "#50A14F", "#C18401",
    "#0184BC", "#A626A4", "#0997B3", "#FAFAFA",
    "#4F525E", "#E06C75", "#98C379", "#E5C07B",
    "#61AFEF", "#C678DD", "#56B6C2", "#FFFFFF",
]
