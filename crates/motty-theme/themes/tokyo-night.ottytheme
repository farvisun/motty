# Tokyo Night: written from the scheme's published palette (MIT). By Enkia.

[meta]
name        = "Tokyo Night"
author      = "Enkia"
mode        = "dark"
description = "Downtown Tokyo at night."

[terminal]
foreground           = "#C0CAF5"
background           = "#1A1B26"
cursor               = "#C0CAF5"
cursor-text          = "#1A1B26"
selection-background = "#33467C"
palette = [
    "#15161E", "#F7768E", "#9ECE6A", "#E0AF68",
    "#7AA2F7", "#BB9AF7", "#7DCFFF", "#A9B1D6",
    "#414868", "#F7768E", "#9ECE6A", "#E0AF68",
    "#7AA2F7", "#BB9AF7", "#7DCFFF", "#C0CAF5",
]
